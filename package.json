{
  "name": "adamant-guard",
  "version": "1.2.6",
  "private": true,
  "description": "Адамант - проверка защиты компьютера с Windows и своей домашней или офисной сети. Без внешних зависимостей, ничего не отправляет в интернет.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/launch.js",
    "server": "node server/index.js",
    "stop": "node server/launch.js --stop",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "icon": "node scripts/make-icon.js",
    "dist": "node scripts/build-dist.js",
    "i18n-missing": "node tools/i18n-missing.js",
    "setup": "node scripts/build-dist.js && node scripts/build-setup.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE"
}
